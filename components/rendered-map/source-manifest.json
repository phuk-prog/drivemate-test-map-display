 "app_wiring_not_published": [
  "MapController.addLayers calls RouteLayers.add(style, night) under the car layer",
  "MapController.showRoutes and setRouteProgress fill RouteLayers.SRC_ROUTE / SRC_DRIVEN via RouteLayers.lines",
  "MapController.applyTraffic fills RouteLayers.TRAFFIC_SRC via RouteLayers.traffic when the Traffic toggle is on",
  "TrafficRouteOverlay.Level SLOW/HEAVY take RouteLayers.SLOW_COLOR / HEAVY_COLOR",
  "MapController.enableLocation (after every style load) calls CarMarker.show; setCarIcon calls CarMarker.restyle",
  "MapController.applyFollow sets RenderMode.GPS and CameraMode.NONE while navigating",
  "NavigationSession chooses the arrow's position and bearing (route snap, matched road or raw GPS)"
 ],
