{
  "schema": 1,
  "category": "02",
  "name": "Map display, route line and vehicle arrow",
  "app_repo": "phuk-prog/drivemate-app",
  "public_repo": "phuk-prog/drivemate-test-map-display",
  "evidence_policy": "Category 2 traffic is validated with fully synthetic keyless fixtures against private app classes. No real TomTom API key, real provider response, or personal journey data may be uploaded to the public test repository or CI. Simulation verifies expected parser and overlay logic, not live TomTom availability or UK road/rendered-map truth.",
  "items": [
    {
      "id": "02.01",
      "tests": [
        "pref02_01_verifiedRoadGeometryHasLowDrift",
        "pref02_01_unverifiedRoadCannotBeUsedAsProof"
      ],
      "remaining": "verified real UK carriageway geometry and live overlay"
    },
    {
      "id": "02.02",
      "tests": [
        "pref02_02_paddedCameraLeavesMoreViewAhead",
        "pref02_02_largePanelsCannotConsumeViewport"
      ],
      "remaining": "rendered marker position on phone"
    },
    {
      "id": "02.03",
      "tests": [
        "pref02_03_routePaletteIsNotATrafficState",
        "pref02_03_tomTomV5ParserRetainsLiveGeometryAndSeverity",
        "pref02_03_realSourcePathColoursActualRouteRed",
        "pref02_03_moderateJamIsAmber",
        "pref02_03_staleTomTomReportsAreNotColoured",
        "pref02_03_oppositeCarriagewayTrafficCannotColourRoute",
        "pref02_03_noExtentNoLiveGeometryMeansNoInventedTrafficBand",
        "pref02_03_futureEventExcluded",
        "pref02_03_offRoadReportsCannotColourOurRoute",
        "pref02_03_fixtureIsExplicitlySyntheticAndContainsNoCredential",
        "pref02_03_simulatedHeavyCongestionUsesRedRouteBand",
        "pref02_03_simulatedSlowerTrafficUsesAmberRouteBand",
        "pref02_03_simulatedWrongDirectionMustNotColourOppositeCarriageway",
        "pref02_03_simulatedOffRouteIncidentMustNotColourNearbyRoad",
        "pref02_03_simulatedUnknownDirectionCannotClaimCarriageway",
        "pref02_03_simulatedExpiredAndFutureEventsAreExcluded",
        "pref02_03_simulatedNonCongestionAccidentNotPaintedAsTrafficSpeed",
        "pref02_03_simulatedMalformedCoordinateAndMissingIdAreRejected",
        "pref02_03_simulatedUnknownExtentDoesNotInventRoadCoverage"
      ],
      "static_check": "traffic_layer_integration",
      "remaining": "Simulated API fixtures are acceptance for automated TomTom-parser/traffic-band logic only; authentic live connection and real rendered road mapping remain unverified and require separate evidence, without uploading a credential."
    },
    {
      "id": "02.04",
      "tests": [
        "pref02_04_cameraBearingWrapsShortWayAcrossNorth",
        "pref02_04_carLayerIsIdentifiedBelowOwnOverlays"
      ],
      "remaining": "rendered car marker centred on correct carriageway"
    },
    {
      "id": "02.05",
      "tests": [
        "pref02_05_fastRoadHasWiderZoomThanSlowStreet",
        "pref02_05_nearTurnRaisesZoomWithoutLosingTurnContext"
      ],
      "remaining": "map controller wiring/render replay across all inputs"
    },
    {
      "id": "02.06",
      "tests": [
        "pref02_06_openFastRoadTiltRequiresSustainedSpeed",
        "pref02_06_zoomFollowsRoadSpeedBand"
      ],
      "remaining": "rendered far-ahead road visibility"
    },
    {
      "id": "02.07",
      "tests": [
        "pref02_07_junctionTiltsTowardOverhead",
        "pref02_07_roundaboutUsesJunctionPerspective"
      ],
      "remaining": "junction screenshot and actual exit visible"
    },
    {
      "id": "02.08",
      "tests": [
        "pref02_08_zoomIsTimeRateLimited",
        "pref02_08_tiltDoesNotJumpAcrossOneFix",
        "pref02_08_insetChangesGlideInsteadOfJumping"
      ],
      "remaining": "frame cadence and rendered transitions"
    },
    {
      "id": "02.09",
      "tests": [
        "pref02_09_newTurnCanWidenFittedFrame",
        "pref02_09_geometrySlicePreservesIntermediateRoute"
      ],
      "remaining": "two nearby turns in rendered viewport"
    }
  ],
  "traffic_test_mode": "SIMULATION_ONLY_NO_CREDENTIALS"
}
